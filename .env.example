# LLM provider: openrouter or gemini
LLM_PROVIDER=openrouter

# OpenRouter configuration
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Gemini configuration (optional when using OpenRouter)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_SECRET=generate-a-long-random-value
AUTH0_AUDIENCE=https://api.noha.example
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
AUTH0_REQUIRED_SCOPE=noha:access
AUTH0_ALLOWED_CLIENT_ID=replace-with-bff-client-id
AUTH_SESSION_DB_PATH=./data/auth-sessions.db
AUTH_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_BASE_URL=http://localhost:3000
NOHA_API_BASE_URL=http://127.0.0.1:8000
NOHA_DATABASE_PATH=./data/analyst.db
