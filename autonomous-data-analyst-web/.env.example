# ==============================================================================
# NOHA Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - All variables below are server-only. Never prefix secrets with NEXT_PUBLIC_.
# - For BFF-to-backend communication, use NOHA_API_BASE_URL (canonical).
# ==============================================================================

# Application Base URL (Next.js frontend origin)
# In local development: http://localhost:3000 (or http://127.0.0.1:3000)
# In production: MUST be https://your-domain.com
APP_BASE_URL=http://localhost:3000

# Backend API Base URL (FastAPI backend service)
# Expected local format: http://127.0.0.1:8000 (do not append /api)
NOHA_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Auth0 Tenant Configuration
# ------------------------------------------------------------------------------
# Required for user authentication, dataset upload, and analysis execution.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-me-with-auth0-client-secret
AUTH0_SECRET=generate-a-32-byte-or-longer-random-secret
AUTH0_AUDIENCE=https://api.noha.example
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# ------------------------------------------------------------------------------
# Auth0 Encrypted Session Store Configuration (SQLite)
# ------------------------------------------------------------------------------
AUTH_SESSION_DB_PATH=../data/auth-sessions.db
# Must be exactly 32 cryptographically random bytes, base64-encoded:
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
